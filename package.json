  },
  "devDependencies": {
    "@tgcloud/cli": "0.2.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "typescript": "5.8.3",
    "vite": "7.1.4",
    "vitest": "3.2.4",
    "@types/node": "22.15.29"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
